# ===== IA (plano gratuito) =====
GROQ_API_KEY=
# Confira os modelos atuais em console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
# Reserva opcional, caso o Groq falhe
NVIDIA_API_KEY=
NVIDIA_MODEL=

# ===== Comportamento =====
# Minutos que o bot fica quieto depois que a equipe responde pelo celular
HUMAN_PAUSE_MINUTES=5
# Minutos de pausa depois que a IA transfere o atendimento para a equipe
HANDOFF_PAUSE_MINUTES=30
HISTORY_MAX=12
HISTORY_TTL_HOURS=24
MAX_REPLIES_PER_HOUR=20
# Atraso "digitando..." antes de cada resposta (reduz o risco de bloqueio e soa mais natural)
MIN_DELAY_SECONDS=2
MAX_DELAY_SECONDS=6

# ===== Segurança do número =====
# Números que o bot NUNCA responde (equipe, colegas), só dígitos com DDI, separados por vírgula
IGNORE_NUMBERS=
# Para TESTAR: se preenchido, o bot responde SOMENTE a estes números
ONLY_NUMBERS=

# ===== Painel local =====
PANEL_PORT=3030

# ===== Navegador (opcional) =====
# Caminho do Chrome/Chromium já instalado, se não quiser usar o que o Puppeteer baixa
CHROME_PATH=
